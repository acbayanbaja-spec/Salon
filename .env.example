# ================================================================
# GLOW SMART SALON - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ================================================================

# --- DATABASE CONFIGURATION ---
# Option A: Individual DB parameters (Local XAMPP or Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kap_salon
DB_USER=root
DB_PASS=

# Option B: Full connection string (e.g. from Aiven Cloud Dashboard)
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-xxxxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# --- SMS CONFIGURATION (PhilSMS / Semaphore) ---
# Default provider: philsms (or semaphore)
SMS_PROVIDER=philsms
SMS_ENABLED=false

# PhilSMS (app.philsms.com): paste your API Bearer token here
PHILSMS_API_KEY=your_philsms_api_token_here
# Sender ID: PhilSMS default or registered alphanumeric sender name (max 11 chars)
PHILSMS_SENDER_ID=PhilSMS

# --- APPLICATION SETTINGS ---
BRAND="Glow Smart Salon"
# Secret key for calling reminders.php?key=YOUR_CRON_KEY
CRON_KEY=change-this-secret-key

# --- EMAIL SETTINGS (Optional - false = offline mode) ---
MAIL_ENABLED=false
GMAIL_USER=your@gmail.com
GMAIL_APP_PASS="xxxx xxxx xxxx xxxx"
ADMIN_EMAIL=your@gmail.com
